<Window x:Class="SmsTest.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Тестовое WPF-приложение для SmartMealService"
        Width="1024"
        Height="480"
        MinWidth="700"
        MinHeight="350"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize">

    <Window.Resources>

        <!-- Заголовки колонок -->
        <Style x:Key="DataGridHeaderStyle"
            TargetType="{x:Type DataGridColumnHeader}">

            <Setter Property="Background"
                Value="White" />

            <Setter Property="Foreground"
                Value="Black" />

            <Setter Property="FontSize"
                Value="20" />

            <Setter Property="Padding"
                Value="15,0" />

            <Setter Property="BorderBrush"
                Value="Black" />

            <Setter Property="BorderThickness"
                Value="0,0,1,1" />

            <Setter Property="Height"
                Value="32" />

        </Style>

        <Style x:Key="DataGridCellStyle"
            TargetType="{x:Type DataGridCell}">

            <Setter Property="Height"
                Value="32" />

        </Style>

    </Window.Resources>

    <Border 
        Margin="30,14,30,20"
        Background="White"
        CornerRadius="30">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Grid Grid.Row="0"
                Margin="25,0,20,0"
                MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="45" />
                    <ColumnDefinition Width="45" />
                </Grid.ColumnDefinitions>

                <!-- Заголовок -->
                <TextBlock Grid.Column="0"
                    Text="Тестовое WPF-приложение для SmartMealService"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="Black" />

                <!-- Свернуть -->
                <Button Grid.Column="1"
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Click="OnMinimizeButtonClick"
                    ToolTip="Свернуть">

                    <md:PackIcon
                        Kind="WindowMinimize"
                        Width="25"
                        Height="25"
                        Foreground="#404040" />

                </Button>

                <!-- Закрыть -->
                <Button Grid.Column="2"
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Click="OnCloseButtonClick"
                    ToolTip="Закрыть" >

                    <md:PackIcon
                        Kind="CloseThick"
                        Width="25"
                        Height="25"
                        Foreground="#404040" />

                </Button>

            </Grid>

            <!-- Таблица -->
            <Border Grid.Row="1"
                Margin="25,5,25,25"
                BorderBrush="Black"
                BorderThickness="2"
                CornerRadius="30"
                Background="White">

                <Grid>

                    <Border x:Name="GridMask" 
                        Background="White" 
                        CornerRadius="30"/>

                    <DataGrid
                        ItemsSource="{Binding Variables}"
                        Foreground="Black"
                        FontFamily="Calibri"
                        FontSize="20"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserResizeRows="False"
                        CanUserReorderColumns="False"
                        SelectionMode="Single"
                        SelectionUnit="Cell"
                        HeadersVisibility="Column"
                        GridLinesVisibility="All"
                        BorderThickness="0"
                        CanUserSortColumns="False"
                        IsReadOnly="False"
                        Background="White"
                        ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                        CellStyle="{StaticResource DataGridCellStyle}"
                        >

                        <DataGrid.OpacityMask>
                            <VisualBrush Visual="{Binding ElementName=GridMask}" />
                        </DataGrid.OpacityMask>

                        <DataGrid.Columns>

                            <!-- Поле -->
                            <DataGridTextColumn
                                Header="Поле"
                                Binding="{Binding Name}"
                                Width="1*"
                                IsReadOnly="True"
                                />

                            <!-- Значение -->
                            <DataGridTemplateColumn
                                Header="Значение"
                                Width="1*">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding Value}"
                                            VerticalAlignment="Center"
                                            TextWrapping="NoWrap" />
                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox
                                            Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                            TextWrapping="NoWrap" 
                                            />

                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- Комментарий -->
                            <DataGridTextColumn
                                Header="Комментарий"
                                Width="1.5*"
                                Binding="{Binding Comment}"
                                IsReadOnly="True" />

                        </DataGrid.Columns>

                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>