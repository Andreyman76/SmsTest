{
    "EnvironmentVariables": {
        "KnownVariables": [
            {
                "Name": "SMS_TEST_HTTP_ENDPOINT",
                "Comment": "Адрес HTTP сервиса"
            },
            {
                "Name": "SMS_TEST_GRPC_ENDPOINT",
                "Comment": "Адрес gRPC сервиса"
            },
            {
                "Name": "SMS_TEST_USERNAME",
                "Comment": "Имя пользователя HTTP сервиса"
            },
            {
                "Name": "SMS_TEST_PASSWORD",
                "Comment": "Пароль пользователя HTTP сервиса"
            }
        ]
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/test-sms-wpf-app-.log",
                    "rollingInterval": "Day"
                }
            }
        ]
    }
}